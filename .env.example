# Local development: copy to .env and fill in your keys.
# For Streamlit Cloud, copy these into "Secrets" in the Advanced settings, not as a .env file.

GROQ_API_KEY=
BREVO_API_KEY=your_brevo_xkeysib_key
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Applylytics
# Optional fallback when Groq rate-limits (429) or payload is too large (413):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Default: fast model (lower TPM). For higher quality when quota allows: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FAST_MODEL=llama-3.1-8b-instant
REDIS_URL=redis://localhost:6379/0
APP_PASSWORD=
PORTFOLIO_URL=https://github.com/9chirla
DEBUG_MODE=false
